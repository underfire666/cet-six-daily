# V12 backend env example. Copy to .env.local and fill real values locally.
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/cet_daily?schema=public"

# Auth.js / NextAuth secret. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-long-random-string"

# Set to "true" only in local dev to allow next-auth dev logging.
NODE_ENV="development"
