# China single-server deployment template; these placeholders are NOT usable.
# Copy to .env.china.local, fill real values, and run the preflight before starting.
# Do not commit .env.china.local or send its contents in chat/screenshots.

# A single real DNS hostname, without https://, a port, path or wildcard.
# AUTH_URL is derived by Compose as https://SITE_DOMAIN.
SITE_DOMAIN=your-app.example.com

# Generate this separately with: openssl rand -hex 32
# Exactly 64 hexadecimal characters avoid PostgreSQL URL escaping problems.
POSTGRES_PASSWORD=replace-with-generated-64-hex-characters

# Generate another independent value with: openssl rand -hex 32
# Keep it stable across normal restarts; never reuse the database password.
AUTH_SECRET=replace-with-an-independent-generated-64-hex-secret

# Optional production image name. The default is built from the local Dockerfile.
# A prebuilt private image can be selected without changing the Compose file.
CET_IMAGE=cet-six-daily:v15-china
