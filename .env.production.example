# Copy to .env.production.local for a local production preview only.
# On Render, use the environment settings generated by render.yaml instead.
NODE_ENV="production"
DATABASE_URL="postgresql://cet_user:replace-with-database-password@your-database-host:5432/cet_daily?schema=public"
# Generate a new independent secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-new-random-secret"
AUTH_URL="https://your-app.onrender.com"
AUTH_TRUST_HOST="true"
HOSTNAME="0.0.0.0"
PORT="3000"
